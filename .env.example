# Copy this file to .env.local and adjust values.
DATABASE_URL=postgres://crittable:crittable@localhost:5432/crittable

# Generate with: openssl rand -hex 32
# or https://generate-secret.vercel.app/32 on Windows
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:3000

# Resend (https://resend.com) — optional for local dev.
# Without these, emails are logged to the console instead.
# RESEND_API_KEY=re_...
# RESEND_FROM=CritTable <events@yourdomain.com>

# Discord OAuth — optional.
# Create an app at https://discord.com/developers/applications
# Set redirect URI to: {BETTER_AUTH_URL}/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Scheduled announcements — optional but recommended in production.
# Protects POST /api/cron/send-announcements from being triggered by anyone
# who finds the URL. Set this, then point your scheduler (Vercel Cron, a
# system cron job, etc.) at that URL every few minutes with:
#   Authorization: Bearer <CRON_SECRET>
# Without it set, the endpoint is open — fine for local dev, not for prod.
# CRON_SECRET=
