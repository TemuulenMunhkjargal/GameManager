# GameHall works without an environment file. These are optional overrides.
# Defaults to .gamehall/gamehall.db inside the project.
# GAMEHALL_DB_PATH=C:/Users/you/Documents/GameHall/gamehall.db

# Resend is optional. Without these, email messages are logged locally.
# RESEND_API_KEY=re_...
# RESEND_FROM=GameHall <events@yourdomain.com>
