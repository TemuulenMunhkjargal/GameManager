{
  "name": "gamehall",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "GameHall, a local-first planner for personal game nights.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:open\"",
    "desktop:open": "wait-on http://127.0.0.1:3000 && electron .",
    "build": "next build",
    "desktop:clean": "node scripts/clean-desktop.mjs",
    "desktop:build": "npm run desktop:clean && npm run build && node scripts/prepare-desktop.mjs && electron-builder --win --publish never",
    "desktop:dir": "npm run desktop:clean && npm run build && node scripts/prepare-desktop.mjs && electron-builder --win --dir --publish never",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests electron scripts *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "next": "^16.2.9",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "^8.5.10",
    "typescript": "latest",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "build": {
    "appId": "com.gamehall.desktop",
    "productName": "GameHall",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.cjs",
      "runtime.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server"
      },
      {
        "from": ".desktop-runtime",
        "to": "runtime"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "GameHall-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
